# Copy to .env and fill in. Never commit .env.

# Use the restricted app role, not postgres (see README > Setup > Database).
# On Supabase instead: Connect > Session pooler, username jobtracker_app.<project-ref>.
DATABASE_URL=postgresql://jobtracker_app:your-app-role-password@localhost:5432/jobtracker_dev

# At least 32 random characters. Generate one in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

ACCESS_TOKEN_MINUTES=30

# Comma-separated exact origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# "production" turns on HSTS and turns off /docs
ENVIRONMENT=development

# Only for running the database tests locally (a THROWAWAY database whose name contains "test").
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker_test
